# Phase 2 (docs/adr/0150): platform-core's local port (root .env.example
# PORT=3000) — serves /oauth/*, /graphql, everything Module 01/02 owns.
# Distinct from scheduling-service's own base URL below.
EXPO_PUBLIC_AUTH_API_BASE_URL=http://localhost:3000

# employeeId dev-only stub (docs/adr/0149, still needed post-Phase-2 per
# docs/adr/0150 — there is no userId -> Employee lookup in the platform API
# yet). tenantId now comes from the real signed-in session, not from here.
# Never set in a production build profile (see eas.json).
EXPO_PUBLIC_DEV_EMPLOYEE_ID=

# scheduling-service's local API port (scheduling-service/README.md).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8100

# Phase 3 (docs/adr/0152): mobile-ess-service's local port — POST
# /v1/mobile/sync. Distinct from EXPO_PUBLIC_API_BASE_URL above, which is
# scheduling-service-specific despite its generic-sounding name.
EXPO_PUBLIC_MOBILE_ESS_API_BASE_URL=http://localhost:8800

# Phase 5 (docs/adr/0154): required by expo-notifications' getExpoPushTokenAsync()
# to mint a real push token. Requires `eas init` against a real Expo
# account/project — an external, account-level prerequisite this repo's
# code cannot itself provision (named explicitly, same discipline as
# docs/adr/0150's employeeId dev stub). pushToken.ts throws a clear, named
# error if this is unset rather than an opaque SDK failure.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Phase 7 (docs/adr/0156): intraday-service (Module 05) - agentLiveState
# GraphQL query, the Adherence tab's "right now" section. Own port, since
# EXPO_PUBLIC_API_BASE_URL above is scheduling-service-specific.
EXPO_PUBLIC_INTRADAY_API_BASE_URL=http://localhost:8200

# Phase 7 (docs/adr/0156): adherence-compliance-service (Module 08) -
# adherenceScoreToday GraphQL query, the Adherence tab's "today's
# adherence %" section.
EXPO_PUBLIC_ADHERENCE_COMPLIANCE_API_BASE_URL=http://localhost:8500

# Phase 7 (docs/adr/0156): attendance-leave-service (Module 06) - the
# Hours tab's worked-hours and leave-balance REST endpoints. Same service
# clock-in/out already forwards to via mobile-ess-service, but this is a
# direct mobile-app -> attendance-leave-service call (docs/adr/0146),
# unrelated to that forwarding path.
EXPO_PUBLIC_ATTENDANCE_LEAVE_API_BASE_URL=http://localhost:8300
