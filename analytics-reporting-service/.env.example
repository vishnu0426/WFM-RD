NODE_ENV=development
PORT=8600

# §2 (ADR-0108, extending ADR-0093's pattern): shared `agno_wfm` database,
# new `analytics`/`analytics_mv` schemas + role. The app connects as
# `agno_analytics_app`, never as the migration role - `npm run
# migration:run` reads DB_MIGRATION_* directly via src/database/data-source.ts,
# so a running instance of the app can never hold migrator credentials in
# memory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_analytics_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-analytics-reporting-service

# Phase 2 (§0.6, ADR-0108): the analytics read replica - a streaming
# physical replica of the same `agno_wfm` primary above, not a separate
# database or a docker-compose service (Terraform's job in any real
# deployment, per docker-compose.yml's own existing disclaimer). The MV
# refresh jobs' cross-schema *source* reads (`MvAdherenceTrendRollupRefreshJobService`/
# `MvForecastAccuracyTrendRefreshJobService`) point at this host via
# `agno_migrator` (`migrator-replica-pool.provider.ts`, ADR-0098's
# credential-reuse precedent). Phase 4's live dashboard/report-builder/
# BI-connector reads (via `agno_analytics_app`) will point at this same
# host once that phase lands - not wired yet.
#
# Defaults to the same primary host/port for a pure local `docker-compose
# up` with no separately-provisioned standby - the app boots and the
# refresh jobs run correctly either way, just without genuine replica load
# isolation until DB_HOST and this differ for real (e.g. a developer's own
# manually-provisioned local streaming standby via `pg_basebackup`, or a
# real Terraform-provisioned replica in any real deployment).
ANALYTICS_REPLICA_DB_HOST=localhost
ANALYTICS_REPLICA_DB_PORT=5432

# Phase 6 (§4.2/§1): `POST /v1/analytics/exports`' real S3 export target
# (CSV) - own copy of adherence-compliance-service's identical pattern
# (docs/adr/0105). Credentials/region are read from the AWS SDK's own
# standard env vars (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION),
# not custom ones. _ENDPOINT/_FORCE_PATH_STYLE are unset by default (real
# AWS); set them to point this same client at a local MinIO instance for
# verification without any real AWS account, e.g.:
#   ANALYTICS_EXPORTS_S3_ENDPOINT=http://localhost:9000
#   ANALYTICS_EXPORTS_S3_FORCE_PATH_STYLE=true
ANALYTICS_EXPORTS_S3_BUCKET=agno-wfm-analytics-exports-dev
ANALYTICS_EXPORTS_S3_ENDPOINT=
ANALYTICS_EXPORTS_S3_FORCE_PATH_STYLE=false

# ADR-0163: remote-JWKS RBAC for dashboard/myDashboards/createDashboard/
# updateDashboard (DashboardResolver only - see the ADR for what stays
# ungated). Own copy of adherence-compliance-service's identical
# resource-server config. CORE_JWKS_URI/OIDC_ISSUER/OIDC_AUDIENCE must
# match core's own OAuth issuer config exactly, or every gated request
# fails signature/issuer/audience verification.
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api

# ADR-0165: this service's first gRPC client - Module 10's (ai-layer-service)
# NlQueryBridgeService.TranslateQuestion/GenerateAnswer, backing
# askAnalyticsQuestion (ADR-0111). Default matches ai-layer-service's own
# GRPC_URL.
AI_LAYER_GRPC_URL=localhost:7300
