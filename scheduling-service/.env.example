# Postgres connection used by the application at runtime (goes through PgBouncer
# in real deployments). Same `agno_wfm` database Module 01/02/03 use - a new
# `scheduling` schema, not a new database. See docs/adr/0052.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_scheduling_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm

# Migration role - same agno_migrator used by Module 01/02/03's migrations.
# Never used by the running application, only by `alembic upgrade`.
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

# NATS JetStream - replaces the source spec's Kafka reference platform-wide.
# Same broker Module 03 already runs against (docker-compose's `nats`
# service); this module owns its own stream/subject namespace.
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=AGNO_SCHEDULING

# Module 07 (docs/adr/0082) - this service's own gRPC server bind address,
# exposing SchedulingEligibilityService to shift-marketplace-service.
SCHEDULING_GRPC_BIND_ADDRESS=0.0.0.0:8102

# GAP-08 fix (enterprise readiness audit, 2026-08-18) - every request now
# needs a real Authorization: Bearer JWT verified against the root
# platform-core service's JWKS, not a raw X-Tenant-Id header. Defaults match
# the root app's own local-dev issuer/audience/JWKS URL - only override if
# you're running the root service on a non-default host/port.
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api

ENVIRONMENT=development
PORT=8100
