NODE_ENV=development
PORT=8400

# §2 (ADR-0083): shared `agno_wfm` database, new `marketplace` schema +
# role - same pattern as ADR-0017/0052/0066/0073. The app connects as
# `agno_marketplace_app`, never as the migration role - `npm run
# migration:run` reads DB_MIGRATION_* directly via src/database/data-source.ts,
# so a running instance of the app can never hold migrator credentials in
# memory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_marketplace_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-shift-marketplace-service

# Phase 2 (§1, ADR-0085): the distributed claim lock - the module's actual
# concurrency-safety mechanism, not a cache. Same broker docker-compose
# already provisions for Module 05/06.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Phase 2 (§0/§4, ADR-0082/0086): scheduling-service's own gRPC *server*
# bind address - SchedulingEligibilityService.CheckAssignmentEligibility,
# this module's guardrail-validation call. Default matches
# scheduling-service's own SCHEDULING_GRPC_BIND_ADDRESS default (:8102).
SCHEDULING_GRPC_URL=localhost:8102

# Phase 4 (ADR-0088): core's own gRPC server - EmployeeService.
# GetSchedulableEmployees, this module's own first Module 02 gRPC client,
# used by BidService's seniority-ranking method (hire_date). Default
# matches core's own GRPC_URL default (src/main.ts, 0.0.0.0:5000).
CORE_GRPC_URL=localhost:5000

# Phase 5 (§4 step 7, ADR-0089): this service's first NATS presence -
# ShiftClaimApproved/SwapExecuted, the actual Module 04 handoff. Same local
# broker docker-compose already provisions for Module 01/02/05/06. Run
# `npm run nats:provision-streams` from the repo root before expecting
# AGNO_MARKETPLACE_EVENTS to exist.
NATS_URL=nats://localhost:4222

# Phase 5 (§0.5's progressive-delivery row, ADR-0089): tenant-configurable
# auto-approval opt-in - a JSON array of tenant ids, defaulting to empty
# (every tenant requires supervisor approval unless explicitly listed
# here). Explicit, flat-env-config placeholder - no tenant-settings
# service exists anywhere in this platform yet to hook a real per-tenant
# flag into (`TenantMarketplacePolicyService`'s own doc comment).
# Example: ["11111111-1111-1111-1111-111111111111"]
MARKETPLACE_AUTO_APPROVAL_TENANT_IDS=[]

# Phase 6 (§5.2): anti-abuse rate limiting on claim attempts specifically -
# distinct from Module 01's own tenant-level Envoy token-bucket, which
# protects the API gateway from raw request volume but wouldn't distinguish
# scripted rapid-fire claiming from a legitimate burst of unrelated traffic.
# Defaults: 10 claim attempts per 60s window per (tenant, employee).
# Failed/rejected attempts count toward the limit; successful claims and
# read-only browsing do not (`ClaimAttemptRateLimiterService`).
MARKETPLACE_CLAIM_ATTEMPT_LIMIT=10
MARKETPLACE_CLAIM_ATTEMPT_WINDOW_SECONDS=60

# Per-tenant overrides, same flat-env-config placeholder posture as
# MARKETPLACE_AUTO_APPROVAL_TENANT_IDS - no tenant-settings service exists
# yet to hook a real per-tenant configuration into.
# Example: {"11111111-1111-1111-1111-111111111111": {"limit": 20, "windowSeconds": 60}}
MARKETPLACE_CLAIM_ATTEMPT_LIMIT_OVERRIDES={}

# Phase 7 (§2.2 rule 3, ADR-0091): points earned per engagement event type -
# `MarketplaceEngagementService`. A flat global default (not per-tenant like
# the two settings above - nothing in this module's own prompt asks for
# per-tenant point tuning).
MARKETPLACE_POINTS_CLAIM_APPROVED=10
MARKETPLACE_POINTS_SWAP_EXECUTED=5
