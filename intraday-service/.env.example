NODE_ENV=development
PORT=8200

# Phase 3 (ADR-0066): the compliance/historical store, shared `agno_wfm`
# database, new `intraday` schema + role - same pattern as ADR-0052. The
# app connects as `agno_intraday_app` (DB_*), never as the migration role -
# `npm run migration:run` reads DB_MIGRATION_* directly via
# src/database/data-source.ts, so a running instance of the app can never
# hold migrator credentials in memory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_intraday_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

# Redis - Module 05's live-state system of record (ADR-0062), not a cache.
# Same local instance docker-compose already provisions for Module 01/02;
# no new container needed (see design doc's "Blast radius").
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NATS JetStream - same local broker docker-compose already provisions.
# Run `npm run nats:provision-streams` from the repo root (scripts/
# provision-nats-streams.ts) before expecting AGNO_INTRADAY_* streams to exist.
NATS_URL=nats://localhost:4222

# Webhook ingestion (§4.2). Per-tenant ingestion HMAC secrets now live in
# `intraday.ingestion_credential` (Vault-backed via secret_reference, see
# IngestionCredentialsService) - issued/rotated/revoked through
# POST/GET /v1/intraday/ingestion-credentials, not this file. The
# `INTRADAY_WEBHOOK_SECRETS` env-var map HmacSignatureGuard used through
# Phase 2 is gone; VAULT_ADDR/VAULT_TOKEN below are what it reads instead.

# How much clock skew/replay window to tolerate on the `t=<unix_ms>` in the
# HMAC signature header (ADR-0046's shape, verified in reverse - see
# HmacSignatureGuard).
INTRADAY_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# HashiCorp Vault KV v2 - where IngestionCredentialsService stores every
# ingestion HMAC secret (own copy of integration-hub-service's VAULT_*
# config, same instance in local dev: `vault server -dev`).
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_KV_MOUNT=secret

# TTL for the Redis-backed ingestion idempotency lock, keyed on the ACD/CCaaS
# system's own event id (§4.2, ADR-0047's idiom, own copy - see design doc
# assumption #2 for why this is Redis-backed rather than a durable ledger
# in this phase).
INTRADAY_IDEMPOTENCY_TTL_SECONDS=86400

# Phase 2 (§2.2 rule 2, ADR-0064/0065): scheduling-service's own base URL -
# ScheduleServiceClient calls its employee-scoped shift-assignments
# endpoint. Default matches scheduling-service's own default PORT (8100).
SCHEDULING_SERVICE_URL=http://localhost:8100

# Phase 2: TTL for the "tracked employee" marker
# (IntradayRedisService.trackEmployeeForScheduleSync) that determines who
# ShiftStartPreloadSchedulerService's cron tick checks each minute. 48h is
# generous enough to cover a shift published in advance plus its own
# duration; refreshed on every schedule.published/assignment.changed event
# for that employee, so an actively-scheduled employee never falls out of
# tracking mid-window.
SCHEDULE_TRACKED_EMPLOYEE_TTL_SECONDS=172800

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-intraday-service

# Module 10 Phase 4 (docs/adr/0120): this service's first gRPC server -
# ReallocationService.GetReallocationForExplanation, called by Module 10's
# `explainReallocation`/`rootCauseAnalysis`. Not wired to anything before
# this phase.
GRPC_URL=0.0.0.0:7200
