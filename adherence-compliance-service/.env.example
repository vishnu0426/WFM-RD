NODE_ENV=development
PORT=8500

# §2 (ADR-0093): shared `agno_wfm` database, new `compliance` schema + role -
# same pattern as ADR-0017/0052/0066/0073/0083. The app connects as
# `agno_compliance_app`, never as the migration role - `npm run
# migration:run` reads DB_MIGRATION_* directly via src/database/data-source.ts,
# so a running instance of the app can never hold migrator credentials in
# memory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_compliance_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-adherence-compliance-service

# Phase 3 (§1, ADR-0094, revised by ADR-0098): the rollup job reads Module
# 05's `intraday.adherence_event` directly, via the *same* `agno_migrator`
# credentials above (DB_MIGRATION_*) - not a separate `agno_intraday_app`
# connection. Module 05's data lives in this same `agno_wfm` database, just
# a different schema; `agno_migrator` already owns every schema in it
# (including `intraday`), so it structurally bypasses RLS for this
# cross-tenant read the same way Module 05's own two schedulers
# (`AdherenceRollupSchedulerService`/`AdherencePartitionSchedulerService`)
# already use it for their own cross-tenant ticks - no new role or
# credential to provision. An earlier draft of this file declared
# `INTRADAY_DB_READONLY_USERNAME=agno_intraday_app` before this was worked
# out; ADR-0098 documents the correction.

# Phase 3: rollup job tuning. Trailing windows are re-aggregated on every
# tick (not just "since last tick") to catch late-arriving events, same
# posture as Module 05's own `AdherenceRollupSchedulerService`.
ADHERENCE_DAILY_ROLLUP_TRAILING_DAYS=2
ADHERENCE_WEEKLY_MONTHLY_ROLLUP_TRAILING_DAYS=35
# "Major" deviation threshold (seconds) - a non-adherent segment shorter
# than this doesn't count toward AdherenceScore.majorDeviationCount. 5
# minutes is a placeholder default appropriate for local verification, not
# a considered production threshold - a real value is a policy question for
# whichever phase first ties this to an actual compliance consequence.
ADHERENCE_MAJOR_DEVIATION_THRESHOLD_SECONDS=300

# Phase 3/ADR-0099: this service's first gRPC *clients* - EmployeeService.
# GetEmployeeOrgUnits and CalendarService.GetWorkingTimeRules, both served
# by core (root src/), resolving each employee's real IANA timezone so the
# rollup buckets by their own local calendar day/week/month rather than a
# UTC assumption. Default matches core's own gRPC server default
# (src/main.ts's GRPC_URL ?? '0.0.0.0:5000').
CORE_GRPC_URL=localhost:5000

# Phase 4 (§3.3, ADR-0095): this service's own gRPC server -
# ComplianceRuleService.GetActiveRule/ValidatePolicyAgainstFloor, called by
# Module 02's EmploymentPolicy write path and Module 04's PolicyService.
# Not wired to anything in this phase.
GRPC_URL=0.0.0.0:7100

# Phase 6 (§3.2, §1, docs/adr/0105): generateComplianceReport's real S3
# export target (CSV, not PDF/Excel - see the ADR). Credentials/region are
# read from the AWS SDK's own standard env vars (AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY/AWS_REGION), not custom ones. _ENDPOINT/
# _FORCE_PATH_STYLE are unset by default (real AWS); set them to point this
# same client at a local MinIO instance for verification without any real
# AWS account, e.g.:
#   COMPLIANCE_REPORTS_S3_ENDPOINT=http://localhost:9000
#   COMPLIANCE_REPORTS_S3_FORCE_PATH_STYLE=true
COMPLIANCE_REPORTS_S3_BUCKET=agno-wfm-compliance-reports-dev

# Phase 7 (§5b, docs/adr/0106): the retention lifecycle job's own per-tick
# cap on how many expired, non-legal-held compliance_report rows it will
# delete in one run - bounds a single tick's blast radius rather than
# deleting an unbounded batch.
RETENTION_LIFECYCLE_BATCH_SIZE=100
COMPLIANCE_REPORTS_S3_ENDPOINT=
COMPLIANCE_REPORTS_S3_FORCE_PATH_STYLE=false

# ADR-0161: remote-JWKS RBAC for createComplianceRule/activateComplianceRule/
# generateRuleChangeImpactPreview/generateComplianceReport/legal-hold - own
# copy of integration-hub-service's/ai-layer-service's identical
# resource-server config. CORE_JWKS_URI/OIDC_ISSUER/OIDC_AUDIENCE must
# match the root platform-core service's own configured values exactly.
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api
