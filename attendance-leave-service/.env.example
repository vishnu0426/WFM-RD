NODE_ENV=development
PORT=8300

# §2 (ADR-0073): shared `agno_wfm` database, new `attendance_leave` schema +
# role - same pattern as ADR-0017/0052/0066. The app connects as
# `agno_attendance_leave_app`, never as the migration role - `npm run
# migration:run` reads DB_MIGRATION_* directly via src/database/data-source.ts,
# so a running instance of the app can never hold migrator credentials in
# memory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_attendance_leave_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-attendance-leave-service

# Phase 2 (§3.2): badge/biometric webhook HMAC secrets. Same explicit
# Phase-1-assumption posture as Module 05's INTRADAY_WEBHOOK_SECRETS: a
# tenantId -> secret JSON map, not a durable per-tenant store. Never reuse
# these values outside local dev.
# Example: {"11111111-1111-1111-1111-111111111111":"dev-secret-tenant-1"}
ATTENDANCE_WEBHOOK_SECRETS={}

# How much clock skew/replay window to tolerate on the `t=<unix_ms>` in the
# HMAC signature header (ADR-0046's shape, verified in reverse - see
# HmacSignatureGuard).
ATTENDANCE_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Phase 2 (ADR-0064): scheduling-service's own base URL -
# ScheduleServiceClient calls its employee-scoped shift-assignments
# endpoint for exception detection (§2.2 rule 3). Default matches
# scheduling-service's own default PORT (8100).
SCHEDULING_SERVICE_URL=http://localhost:8100

# Phase 2: grace-period thresholds (minutes) before a clock-in/clock-out is
# flagged `late`/`early_leave` (§2.1). Flat env config for this phase, not
# per-tenant/per-EmploymentPolicy - see the Phase 2 design doc's explicit
# assumptions for why, and what would replace this.
ATTENDANCE_LATE_GRACE_MINUTES=10
ATTENDANCE_EARLY_LEAVE_GRACE_MINUTES=10

# Phase 4 (§1, ADR-0077): first Redis presence in this service - BullMQ
# only, per §1's tech-stack table ("background job queue, not system of
# record"). No other data lives in Redis; LeaveBalance/LeaveRequest stay
# Postgres's job.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Phase 4: how long a leave request may sit `pending` before the
# leave-approval-reminders queue's worker logs/metrics it as stale (ADR-0077).
# 10 minutes is a placeholder default appropriate for local
# verification, not a considered production SLA - a real value belongs to
# whichever phase wires this into an actual notification channel.
LEAVE_APPROVAL_REMINDER_DELAY_MS=600000

# Phase 5 (§3.4, ADR-0078): this service's own gRPC server -
# LeaveService.GetUnavailability, called by scheduling-service's
# mid-solve pull. Moved off the originally-documented :7000 (collides with
# macOS's own AirPlay Receiver, a real local-dev conflict) to :7050, which
# sits between attendance-leave's old slot and adherence-compliance-service's
# :7100.
GRPC_URL=0.0.0.0:7050

# Phase 6 (§5.1, ADR-0079): this service's first gRPC *client* - calls
# core's AuditService.RecordEvent for every decided backdated LeaveRequest.
# Default matches core's own gRPC server default (src/main.ts's
# GRPC_URL ?? '0.0.0.0:5000').
CORE_GRPC_URL=localhost:5000

# ADR-0150/ADR-0157: AccessTokenGuard's remote JWKS lookup, verifying the
# Bearer token on EmployeeAttendanceRecordController/
# EmployeeLeaveBalanceController - same OIDC Discovery config every other
# copy of this guard uses (docs/adr/0130). Defaults match core's own
# defaults (src/modules/auth/services/token.service.ts).
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api

# Phase 8 (§2.1, ADR-0081): AbsencePatternDetectionJob thresholds. Flat
# env config, not per-tenant - same explicit-assumption posture as
# Phase 2's ATTENDANCE_LATE_GRACE_MINUTES. See that job's own doc comment
# for the confidence-score formulas these feed into.
ABSENCE_PATTERN_FREQUENCY_THRESHOLD_DAYS=10
ABSENCE_PATTERN_FREQUENCY_WINDOW_DAYS=90
ABSENCE_PATTERN_RECURRING_WINDOW_DAYS=180
ABSENCE_PATTERN_RECURRING_MIN_SAMPLE_DAYS=5
ABSENCE_PATTERN_RECURRING_SHARE_THRESHOLD=0.4
ABSENCE_PATTERN_HOLIDAY_WINDOW_DAYS=180
ABSENCE_PATTERN_HOLIDAY_THRESHOLD_COUNT=2

# Phase 5: this service's first NATS presence - agno.leave.request.approved.v1,
# published on decideLeaveRequest approval (the push half of the
# propagation design; LeaveService.GetUnavailability above is the pull
# half). Same local broker docker-compose already provisions for Module
# 01/02/05. Run `npm run nats:provision-streams` from the repo root before
# expecting AGNO_ATTENDANCE_LEAVE_EVENTS to exist.
NATS_URL=nats://localhost:4222
