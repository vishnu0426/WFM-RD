NODE_ENV=development
PORT=8800

# §2 (docs/adr/0151): shared `agno_wfm` database, new `mobile_ess` schema +
# role - same pattern as ADR-0073/etc. The app connects as
# `agno_mobile_ess_app`, never as the migration role - `npm run
# migration:run` reads DB_MIGRATION_* directly via src/database/data-source.ts.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_mobile_ess_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

# docs/adr/0152: real JWT verification from day one (copied from
# ai-layer-service/integration-hub-service's own guard trio, ADR-0130/0145)
# - these three MUST match core's own real values exactly, or every token
# this service tries to verify will fail issuer/audience validation.
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api

# docs/adr/0152: attendance-leave-service's own base URL + the HMAC secret
# this service signs its clock-event forwarding calls with
# (AttendanceClockEventClient). Must hold the SAME secret value already
# configured under attendance-leave-service's own
# ATTENDANCE_WEBHOOK_SECRETS[tenantId] - provisioned in both services' env
# config, not looked up from a shared DB. Same tenantId -> secret JSON map
# shape as that service's own env var.
ATTENDANCE_LEAVE_SERVICE_URL=http://localhost:8300
ATTENDANCE_LEAVE_INGESTION_HMAC_SECRETS={}

# docs/adr/0153 (Phase 4): leave_request also targets attendance-leave-service,
# but a genuinely different endpoint/transport - POST /v1/leave/requests has
# no HmacSignatureGuard at all, just the same X-Tenant-Id header-trust every
# other placeholder-guarded endpoint uses. No secret needed for this one.

# docs/adr/0153 (Phase 4): shift-marketplace-service's own base URL -
# MarketplaceClaimClient's claimOpenShift GraphQL mutation. Also no HMAC -
# X-Tenant-Id + X-Actor-Id header-trust only (ADR-0014/ADR-0084's pattern).
# Default matches shift-marketplace-service's own default PORT (8400).
SHIFT_MARKETPLACE_SERVICE_URL=http://localhost:8400

# docs/adr/0154 (Phase 5): this service's first NATS wiring - a durable
# consumer of attendance-leave-service's already-published
# agno.leave.request.approved.v1 (AGNO_ATTENDANCE_LEAVE_EVENTS stream,
# already provisioned by scripts/provision-nats-streams.ts - this service
# is a new *consumer*, not a new stream).
NATS_URL=nats://localhost:4222

# docs/adr/0154: platform-core's inbound gRPC surface - this service calls
# NotificationPreferenceService.IsPushEnabled to check Module 01's
# NotificationPreference (PUSH channel) before sending a push. Same
# direction/port every other service's own CORE_GRPC_URL already uses
# (root src/main.ts's GRPC_URL default, 0.0.0.0:5000).
CORE_GRPC_URL=localhost:5000

# docs/adr/0154: Expo's push-send API (managed workflow - no APNs/FCM
# credentials needed on this service). Overridable so tests/CI can point
# at a mock instead of the real Expo endpoint.
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
