NODE_ENV=development
PORT=8700

# §2 (ADR-0113): shared `agno_wfm` database, new `ai_layer` schema + role -
# same pattern as ADR-0017/0052/0066/0073/0083/0093/0108. The app connects
# as `agno_ai_app`, never as the migration role.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_ai_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-ai-layer-service

# docs/adr/0117/0129: a deliberate deviation from §1's "Anthropic only,
# platform-wide" default - each tenant brings their own provider/model/API
# key via the `configureAiProvider` GraphQL mutation, stored encrypted
# (`AiProviderConfig.encryptedApiKey`). Four providers are supported:
# anthropic/openai/gemini (cloud, apiKey required) and ollama (self-hosted -
# baseUrl required instead, apiKey optional). There is no platform-wide
# ANTHROPIC_API_KEY/OPENAI_API_KEY/GEMINI_API_KEY env var to set here - this
# is the one encryption-at-rest key this service itself needs, not a
# provider credential. Generate one with e.g. `openssl rand -hex 32` (32 raw
# bytes, hex-encoded) - see AiProviderCredentialCipherService for why a
# static env var is a disclosed, not-yet-production-grade key-management
# posture.
AI_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Phase 2 (docs/adr/0115/0116): this service's first gRPC/REST *clients* -
# ScheduleExplanationDataService (a new gRPC surface Phase 2 added to
# scheduling-service itself) for the read half of the schedule-explanation
# handoff, and the existing REST `POST /v1/scheduling/jobs/{jobId}/explanation`
# for the write half. Defaults match scheduling-service's own
# scheduling_grpc_bind_address/PORT.
SCHEDULING_GRPC_URL=localhost:8102
SCHEDULING_REST_URL=http://localhost:8100

# Phase 2 (§2.2 rule 3): AuditService.RecordEvent, served by core (root
# src/). Default matches core's own gRPC server default
# (src/main.ts's GRPC_URL ?? '0.0.0.0:5000').
CORE_GRPC_URL=localhost:5000

# Phase 5 (docs/adr/0124, §4's event backbone): AIRecommendationCreated/
# AIRecommendationDecided publication - this service's first NATS presence.
NATS_URL=nats://localhost:4222

# Phase 4 (docs/adr/0119): explainForecast's data source -
# ForecastExplanationDataService, a new gRPC surface Phase 4 added to
# forecasting-service itself. Default matches that service's own grpc_url.
FORECASTING_GRPC_URL=localhost:6000

# Phase 4 (docs/adr/0120/0122): explainReallocation/rootCauseAnalysis's
# intraday data source - ReallocationService, this platform's first-ever
# gRPC server on Module 05 (a new gRPC surface Phase 4 added). Default
# matches intraday-service's own GRPC_URL.
INTRADAY_GRPC_URL=localhost:7200

# Phase 4 (docs/adr/0121): rootCauseAnalysis's adherence data source -
# AdherenceRollupService, a new gRPC surface Phase 4 added to
# adherence-compliance-service itself (its second, alongside the existing
# ComplianceRuleService - same process/port). Default matches that
# service's own GRPC_URL.
COMPLIANCE_GRPC_URL=localhost:7100

# Phase 5 (docs/adr/0124): the write-back-through-owning-module execution
# pathway for recommendation_type: 'reallocation' - calls intraday-service's
# own, already-existing `POST /v1/intraday/reallocations/{id}/approve`
# (the exact API a human supervisor would use directly). Default matches
# intraday-service's own PORT.
INTRADAY_REST_URL=http://localhost:8200

# Phase 8 (docs/adr/0130): `AccessTokenGuard`'s remote JWKS - core's own
# real, already-implemented RBAC issuer (`SigningKeyService`/`TokenService`),
# not a fabricated one for this module. Defaults match core's own
# OIDC_ISSUER/OIDC_AUDIENCE and its default PORT=3000 - must match core's
# own values exactly, or every token this service tries to verify will fail
# issuer/audience validation.
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api

# ADR-0162: AiInteractionRateLimitGuard's per-(tenant,actor) in-process
# token bucket, guarding the five AIInteraction-generating operations
# (each a real, billable LLM API call) - this module's own previously
# undisclosed gap. Defaults are a placeholder, same posture as every other
# flat-env-config rate limit in this platform (e.g. shift-marketplace-
# service's MARKETPLACE_CLAIM_ATTEMPT_LIMIT) - not a considered production
# figure. _OVERRIDES is a per-tenant JSON map, e.g.
# {"<tenantId>":{"limit":100,"windowSeconds":60}}.
AI_INTERACTION_RATE_LIMIT=30
AI_INTERACTION_RATE_LIMIT_WINDOW_SECONDS=60
AI_INTERACTION_RATE_LIMIT_OVERRIDES={}

# ADR-0165: this service's first inbound gRPC surface -
# NlQueryBridgeService.TranslateQuestion/GenerateAnswer, called by
# analytics-reporting-service's askAnalyticsQuestion (Module 09, ADR-0111).
# 7300 - the next free port in this platform's own GRPC_URL numbering
# (5000 core, 6000 forecasting, 7050 attendance-leave, 7100 compliance,
# 7200 intraday).
GRPC_URL=0.0.0.0:7300
