{
  "name": "@agno-wfm/acd-onprem-collector",
  "version": "0.1.0",
  "description": "Standalone agent deployed inside a customer's own network to bridge an on-premises ACD (Avaya Aura AES/CMS via CSTA-XML, or a customer's own NATS bus) out to intraday-service's activity-event ingestion endpoint, since a shared multi-tenant cloud service cannot dial into a customer's private network.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
