NODE_ENV=development
PORT=8900

# ADR-0136: shared `agno_wfm` database, new `integration_hub` schema + role -
# same pattern as ADR-0017/0052/0066/0073/0083/0093/0108/0113. The app
# connects as `agno_integration_hub_app`, never as the migration role - `npm
# run migration:run` reads DB_MIGRATION_* directly via
# src/database/data-source.ts, so a running instance of the app can never
# hold migrator credentials in memory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agno_integration_hub_app
DB_PASSWORD=changeme_local_only
DB_DATABASE=agno_wfm
DB_MIGRATION_USERNAME=agno_migrator
DB_MIGRATION_PASSWORD=changeme_local_only

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agno-wfm-integration-hub-service

# Phase 2 (§1, ADR-0134/0137): every connector credential this module ever
# touches is a Vault reference, never an inline secret. Points at a real
# Vault (KV v2 secrets engine) - verified in this build against a local
# `vault server -dev` instance (KV v2 auto-mounted at `secret/` in dev
# mode). No hardcoded local-dev fallback (unlike DB_PASSWORD) - a missing
# Vault config must fail loudly (VaultUnavailableError), never silently
# connect to nothing.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
# Matches Vault dev mode's own default KV v2 mount path. A real deployment
# overrides this to its own mount naming.
VAULT_KV_MOUNT=secret

# Phase 2 (§5a/§7): the batch-runner base's cron tick - a single global
# interval across every active batch connector (no per-connector custom
# schedule yet, see the Phase 2 design doc's explicit assumptions). Default
# is a placeholder appropriate for local verification, not a considered
# production interval - real per-provider timing belongs to Phase 5's rate
# limiting work.
BATCH_SYNC_CRON_EXPRESSION=*/15 * * * *

# Phase 8 (docs/adr/0145): remote-JWKS RBAC for createConnector/
# createWebhookSubscription, own copy of ai-layer-service's identical
# resource-server config - CORE_JWKS_URI/OIDC_ISSUER/OIDC_AUDIENCE must
# match the root platform-core service's own configured values exactly.
CORE_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_ISSUER=https://auth.agno-wfm.local
OIDC_AUDIENCE=agno-core-api
